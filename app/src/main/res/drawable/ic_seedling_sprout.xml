<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Glowing Aura -->
    <path
        android:pathData="M36,36m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="36"
                android:centerY="36"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#354ADE80" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soil Mound -->
    <path
        android:pathData="M16,56 C22,50 50,50 56,56 C52,60 20,60 16,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="50"
                android:endX="56"
                android:endY="60"
                android:type="linear">
                <item android:color="#78350F" android:offset="0.0" />
                <item android:color="#451A03" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stem -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M36,53 C36,44 38,36 39,26" />

    <!-- Left Leaf -->
    <path
        android:pathData="M37,38 C28,34 24,42 30,46 C35,48 37,42 37,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="34"
                android:endX="37"
                android:endY="48"
                android:type="linear">
                <item android:color="#4ADE80" android:offset="0.0" />
                <item android:color="#15803D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Top Leaf -->
    <path
        android:pathData="M39,26 C41,18 51,18 52,26 C52,34 43,32 39,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="18"
                android:endX="52"
                android:endY="34"
                android:type="linear">
                <item android:color="#86EFAC" android:offset="0.0" />
                <item android:color="#16A34A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Little Glowing Dew / Sparkle -->
    <path
        android:fillColor="#FEF08A"
        android:pathData="M48,19m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />
</vector>
